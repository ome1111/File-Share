# 🎉 3. PAYMENT NOTIFICATION (Feature 7)
# ==========================================
@Bot.on_message(filters.command("paid") & filters.private)
async def send_payment_notification(client: Client, message: Message):
    """অ্যাডমিন ইউজারকে পেমেন্ট করার পর এই কমান্ড দিলে ইউজারের কাছে সুন্দর একটি নোটিফিকেশন চলে যাবে"""
    admins = await get_variable("admin", [])
    if message.from_user.id not in admins: 
        return
        
    if len(message.command) < 3:
        return await message.reply_text("❌ **Usage:** `/paid [User_ID] [Amount]`\nExample: `/paid 12345678 500`")
        
    try:
        target_user = int(message.command[1])
        amount = message.command[2]
        
        # ইউজারের ইনবক্সে রসিদ পাঠানো
        receipt_text = f"""
🎉 **Pᴀʏᴍᴇɴᴛ Sᴜᴄᴄᴇꜱꜱғᴜʟ!**

Dear User,
Your withdrawal request of **৳ {amount}** has been successfully processed and sent to your account. 💸

_Thank you for working with us. Keep sharing links and earning more!_
"""
        await client.send_message(chat_id=target_user, text=receipt_text)
        await message.reply_text(f"✅ **Success!** Payment notification sent to `{target_user}`.")
        
    except Exception as e:
        await message.reply_text(f"❌ **Failed to send message:** Make sure the user hasn't blocked the bot.\nError: `{e}`")

