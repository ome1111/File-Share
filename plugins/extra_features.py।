        )
    ]
    await query.answer(results, cache_time=1, is_personal=True)

# ==========================================
# 📁 2. BATCH / PLAYLIST CREATOR (Feature 17)
# ==========================================
@Bot.on_message(filters.command("batch") & filters.private)
async def create_batch_link(client: Client, message: Message):
    """অ্যাডমিনরা ডাটাবেস চ্যানেলের প্রথম ও শেষ ফাইলের আইডি দিয়ে একসাথে অনেকগুলো ফাইলের (Playlist) লিংক বানাতে পারবে"""
    admins = await get_variable("admin", [])
    if message.from_user.id not in admins: 
        return
        
    if len(message.command) < 3:
        text = """
❌ **Incorrect Usage!**

To create a folder/playlist link, you need the Message IDs from your Database Channel.
**Format:** `/batch [Start_ID] [End_ID]`
**Example:** `/batch 105 120` (This will share all files from ID 105 to 120)
"""
        return await message.reply_text(text)
        
    try:
        start_id = int(message.command[1])
        end_id = int(message.command[2])
        
        # ব্যাচ লিংক জেনারেট করা হচ্ছে
        string = f"batch-{start_id * abs(CHANNEL_ID)}-{end_id * abs(CHANNEL_ID)}"
        base64_string = await encode(string)
        link = f"https://t.me/{client.username}?start={base64_string}"
        
        await message.reply_text(
            f"📁 **Batch / Playlist Link Created!**\n\n"
            f"**Files:** From ID `{start_id}` to `{end_id}`\n"
            f"🔗 **Link:**\n`{link}`",
            disable_web_page_preview=True
        )
    except ValueError:
        await message.reply_text("❌ **Message IDs must be numbers!**")

