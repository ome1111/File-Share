        InlineQueryResultArticle(
            title="📁 Recommend this Bot",
            description="Send the bot's standard link to any chat.",
            thumb_url="https://cdn-icons-png.flaticon.com/512/1092/1092216.png",
            input_message_content=InputTextMessageContent(
                f"🤖 **Want to earn money by sharing movies or files?**\n\n"
                f"Just start this bot, upload any file, and get your Earning Link instantly!\n"
                f"🔗 **Start Here:** @{bot_username}"
